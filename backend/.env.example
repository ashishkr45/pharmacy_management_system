# Copy this file to backend/.env and fill in real values. Never commit .env.

# development | test | production
NODE_ENV=development

# Port the API listens on
PORT=4000

# Origin allowed by CORS (frontend dev server or deployed Vercel URL)
FRONTEND_URL=http://localhost:3000

# --- Added in later phases (B2/B3). Uncomment when those phases land. ---
# Neon pooled connection string — used at runtime by the PrismaPg adapter
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Neon direct (non-pooled) connection string — used by the Prisma CLI for migrations
# DIRECT_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# JWT signing secret (long random string; generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
# JWT_SECRET=
# JWT_EXPIRES_IN=8h
