// Pharmacy Management System — Prisma schema (Prisma ORM v7).
//
// Conventions (AGENTS.md §6): models PascalCase, fields camelCase, tables and
// columns snake_case via @map/@@map. Money is Decimal(12,2) — never Float.
// Prisma cannot express CHECK constraints, so the initial migration SQL is
// edited by hand (quantity_on_hand >= 0, quantity > 0, ...).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enums
enum Role {
  ADMIN
  PHARMACIST
  INVENTORY_MANAGER

  @@map("user_role")
}

enum PaymentMethod {
  CASH
  CARD
  UPI

  @@map("payment_method")
}

enum SaleStatus {
  COMPLETED
  PARTIALLY_RETURNED
  FULLY_RETURNED

  @@map("sale_status")
}

enum MovementType {
  OPENING
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT

  @@map("movement_type")
}

enum MovementReferenceType {
  OPENING
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT

  @@map("movement_reference_type")
}

enum AdjustmentReason {
  DAMAGED
  EXPIRED
  COUNT_CORRECTION
  LOST
  OTHER

  @@map("adjustment_reason")
}

// Users
model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  purchases        Purchase[]
  sales            Sale[]
  returns          Return[]
  stockAdjustments StockAdjustment[]
  stockMovements   StockMovement[]
  auditLogs        AuditLog[]

  @@map("users")
}

// Catalogue
model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  medicines Medicine[]

  @@map("categories")
}

model Supplier {
  id            Int      @id @default(autoincrement())
  name          String
  contactPerson String?  @map("contact_person")
  phone         String?
  email         String?
  address       String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  purchases Purchase[]
  batches   Batch[]

  @@index([name])
  @@map("suppliers")
}

model Medicine {
  id               Int      @id @default(autoincrement())
  name             String
  genericName      String?  @map("generic_name")
  sku              String   @unique
  categoryId       Int      @map("category_id")
  unit             String
  reorderLevel     Int      @default(0) @map("reorder_level")
  /// Tax rate percentage (e.g. 5.00). Falls back to settings.defaultTaxRate when null.
  taxRate          Decimal? @map("tax_rate") @db.Decimal(5, 2)
  defaultSalePrice Decimal? @map("default_sale_price") @db.Decimal(12, 2)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  category      Category       @relation(fields: [categoryId], references: [id])
  batches       Batch[]
  purchaseItems PurchaseItem[]
  saleItems     SaleItem[]

  @@index([name])
  @@index([categoryId])
  @@map("medicines")
}

// Purchases and batches
model Purchase {
  id                Int      @id @default(autoincrement())
  supplierId        Int      @map("supplier_id")
  supplierInvoiceNo String   @map("supplier_invoice_no")
  purchaseDate      DateTime @default(now()) @map("purchase_date")
  totalCost         Decimal  @map("total_cost") @db.Decimal(12, 2)
  createdById       Int      @map("created_by_id")
  createdAt         DateTime @default(now()) @map("created_at")

  supplier  Supplier       @relation(fields: [supplierId], references: [id])
  createdBy User           @relation(fields: [createdById], references: [id])
  items     PurchaseItem[]

  @@index([purchaseDate])
  @@map("purchases")
}

model PurchaseItem {
  id         Int      @id @default(autoincrement())
  purchaseId Int      @map("purchase_id")
  medicineId Int      @map("medicine_id")
  batchId    Int      @map("batch_id")
  quantity   Int
  costPrice  Decimal  @map("cost_price") @db.Decimal(12, 2)
  salePrice  Decimal  @map("sale_price") @db.Decimal(12, 2)
  expiryDate DateTime @map("expiry_date") @db.Date

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id])
  batch    Batch    @relation(fields: [batchId], references: [id])

  @@index([medicineId])
  @@index([batchId])
  @@map("purchase_items")
}

model Batch {
  id             Int      @id @default(autoincrement())
  medicineId     Int      @map("medicine_id")
  batchNo        String   @map("batch_no")
  expiryDate     DateTime @map("expiry_date") @db.Date
  quantityOnHand Int      @default(0) @map("quantity_on_hand")
  purchasePrice  Decimal  @map("purchase_price") @db.Decimal(12, 2)
  salePrice      Decimal  @map("sale_price") @db.Decimal(12, 2)
  supplierId     Int?     @map("supplier_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  medicine      Medicine          @relation(fields: [medicineId], references: [id])
  supplier      Supplier?         @relation(fields: [supplierId], references: [id])
  purchaseItems PurchaseItem[]
  saleItems     SaleItem[]
  adjustments   StockAdjustment[]
  movements     StockMovement[]

  @@unique([medicineId, batchNo])
  @@index([expiryDate])
  @@index([medicineId, expiryDate])
  @@map("batches")
}

// Sales, invoice lines and returns
model Sale {
  id             Int           @id @default(autoincrement())
  invoiceNo      String        @unique @map("invoice_no")
  customerName   String?       @map("customer_name")
  customerPhone  String?       @map("customer_phone")
  paymentMethod  PaymentMethod @map("payment_method")
  subtotal       Decimal       @db.Decimal(12, 2)
  taxTotal       Decimal       @map("tax_total") @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  status         SaleStatus    @default(COMPLETED)
  /// Client-supplied Idempotency-Key; unique so a retry cannot create a second sale.
  idempotencyKey String        @unique @map("idempotency_key")
  /// Hash of the request payload; same key + different hash => IDEMPOTENCY_CONFLICT.
  requestHash    String        @map("request_hash")
  createdById    Int           @map("created_by_id")
  createdAt      DateTime      @default(now()) @map("created_at")

  createdBy User       @relation(fields: [createdById], references: [id])
  items     SaleItem[]

  @@index([createdAt])
  @@map("sales")
}

/// One row per (sale line × batch allocation), so FEFO is fully traceable.
model SaleItem {
  id               Int     @id @default(autoincrement())
  saleId           Int     @map("sale_id")
  medicineId       Int     @map("medicine_id")
  batchId          Int     @map("batch_id")
  quantity         Int
  unitPrice        Decimal @map("unit_price") @db.Decimal(12, 2)
  taxRate          Decimal @map("tax_rate") @db.Decimal(5, 2)
  taxAmount        Decimal @map("tax_amount") @db.Decimal(12, 2)
  /// Tax-inclusive line total: round(quantity × unitPrice) + taxAmount.
  lineTotal        Decimal @map("line_total") @db.Decimal(12, 2)
  returnedQuantity Int     @default(0) @map("returned_quantity")

  sale     Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id])
  batch    Batch    @relation(fields: [batchId], references: [id])
  returns  Return[]

  @@index([saleId])
  @@index([batchId])
  @@map("sale_items")
}

model Return {
  id          Int      @id @default(autoincrement())
  saleItemId  Int      @map("sale_item_id")
  quantity    Int
  reason      String
  createdById Int      @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  saleItem  SaleItem @relation(fields: [saleItemId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])

  @@index([saleItemId])
  @@index([createdAt])
  @@map("returns")
}

// Adjustments, ledger, audit, settings
model StockAdjustment {
  id          Int              @id @default(autoincrement())
  batchId     Int              @map("batch_id")
  delta       Int
  reasonCode  AdjustmentReason @map("reason_code")
  note        String?
  createdById Int              @map("created_by_id")
  createdAt   DateTime         @default(now()) @map("created_at")

  batch     Batch @relation(fields: [batchId], references: [id])
  createdBy User  @relation(fields: [createdById], references: [id])

  @@index([batchId])
  @@index([createdAt])
  @@map("stock_adjustments")
}

/// Append-only ledger: exactly one row per quantity change, written in the
/// same transaction as the batch update. SUM(qty_delta) must equal
/// batches.quantity_on_hand for every batch.
model StockMovement {
  id            Int                   @id @default(autoincrement())
  batchId       Int                   @map("batch_id")
  type          MovementType
  qtyDelta      Int                   @map("qty_delta")
  referenceType MovementReferenceType @map("reference_type")
  referenceId   Int?                  @map("reference_id")
  reason        String?
  createdById   Int?                  @map("created_by_id")
  createdAt     DateTime              @default(now()) @map("created_at")

  batch     Batch @relation(fields: [batchId], references: [id])
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([batchId, createdAt])
  @@index([type, createdAt])
  @@map("stock_movements")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?     @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}
