# Copy to backend/.env.test and point it at a SEPARATE test database.
# Never run tests against the demo/production Neon database (AGENTS.md §8).

NODE_ENV=test
PORT=4001
FRONTEND_URL=http://localhost:3000

# Separate Neon branch (recommended) or local Postgres — not the demo DB.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DIRECT_URL=postgresql://user:password@host/dbname?sslmode=require

# Dedicated test signing secret (never the production one; >= 32 characters)
JWT_SECRET=test-only-secret-for-vitest-never-use-in-production-0123456789
JWT_EXPIRES_IN=8h
